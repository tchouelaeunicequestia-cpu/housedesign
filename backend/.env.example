PORT=3000

# Full database connection string (copy it from your Neon console).
# Never commit the real value: keep it only in your local .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Individual variables (only if you split the connection string)
DB_HOST=your-endpoint.region.aws.neon.tech
DB_PORT=5432
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=your-db-name
DB_SSL=true

# Authentication & Secrets (use a long random value, for example from: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Registration closes automatically after the first account exists.
# Set to true only temporarily if you need to create another account.
ALLOW_REGISTRATION=false

# First engineer account, created by: npm run seed (choose a strong password, then remove these two lines)
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# AI assistant (leave both keys empty to keep every AI feature switched off).
# Use ONE of the two. If both are set, Anthropic (Claude) is used unless AI_PROVIDER=openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5-5
# Everything the AI writes waits for your approval in /admin/ai. Set to true to publish automatically.
AI_AUTO_PUBLISH=false
# Optional: e-mail all users when a post is published
AI_EMAIL_ON_PUBLISH=false
# Optional: AI-generated pictures for design concepts (needs OPENAI_API_KEY, costs extra)
AI_IMAGE_ENABLED=false
# AI_IMAGE_MODEL=gpt-image-1
# Months counted as dry season (1-12), used for the seasonal website look
DRY_SEASON_MONTHS=11,12,1,2,3

# Email (used by the AI agent notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="House Design" <no-reply@example.com>
