PORT=3000

# Full database connection string (copy it from your Neon console).
# Never commit the real value: keep it only in your local .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Individual variables (only if you split the connection string)
DB_HOST=your-endpoint.region.aws.neon.tech
DB_PORT=5432
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=your-db-name
DB_SSL=true

# Authentication & Secrets (use a long random value, for example from: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Registration closes automatically after the first account exists.
# Set to true only temporarily if you need to create another account.
ALLOW_REGISTRATION=false

# AI agent (leave empty to keep the AI routines switched off)
OPENAI_API_KEY=

# Email (used by the AI agent notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="House Design" <no-reply@example.com>
